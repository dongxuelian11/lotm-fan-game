{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "vitest/globals"],
    "noEmit": true
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/shared/**/*.ts",
    "tests/renderer/**/*.ts",
    "tests/renderer/**/*.tsx",
    "tests/integration/**/*.ts",
    "vite.config.mts",
    "vitest.config.mts"
  ]
}
