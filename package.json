{
  "name": "lotm-fan-game",
  "version": "0.187.0",
  "private": true,
  "description": "A local-first, original side-story fan game inspired by Lord of Mysteries.",
  "license": "MIT",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "concurrently -k -n MAIN,RENDERER,ELECTRON -c blue,magenta,yellow \"npm:dev:main\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 dist/main/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run clean && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "smoke:electron": "npm run smoke:slice",
    "start": "electron .",
    "smoke:slice": "npm run build && node tests/integration/run-slice-electron-smoke.mjs",
    "typecheck:renderer:app": "tsc -p tsconfig.renderer-app.json --noEmit",
    "test:smoke": "vitest run tests/domain/release-smoke.test.ts tests/domain/slice-creation.test.ts tests/renderer/pathway-navigation.test.tsx --maxWorkers=1 --no-file-parallelism",
    "fixtures:restore": "node test-inputs/restore-test-inputs.mjs",
    "fixtures:check": "node test-inputs/restore-test-inputs.mjs --dry-run",
    "test:fixture-restore": "node --test test-inputs/restore-test-inputs.test.mjs",
    "test:catastrophe-isolated": "node scripts/test-catastrophe-isolated.mjs",
    "test:wisdom-angel-life-isolated": "node scripts/test-wisdom-angel-life-isolated.mjs"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.0.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wait-on": "9.1.0"
  }
}
