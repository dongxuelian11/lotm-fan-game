# Dependencies and generated output
node_modules/
dist/
output/
out/
release/
coverage/
*.tsbuildinfo

# Runtime state must never enter source control
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
userdata/
saves/
runtime-data/

# Private or unlicensed knowledge/content
private/
knowledge/corpus/
knowledge/generated/
content/generated/

# Secrets and local overrides
.env
.env.*
!.env.example
*.pem
*.key

# Logs and test artifacts
*.log
playwright-report/
test-results/
.vitest/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Local Codex/gstack state
.gstack/
.playwright-cli/

# Local third-party evaluation sandboxes (never source authority)
.bmgd-evaluation/

# Local verification and archive workspaces (never publish)
/archive_validation_cache/
/verification_runtime/
/lotm_rebuild_*.zip*
/lotm_rebuild_*.tar.gz
/.codex/
/.cache/

# Expanded test inputs are restored from checked release packs
/tests/fixtures/*
!/tests/fixtures/seer-v030/
/tests/fixtures/seer-v030/*
!/tests/fixtures/seer-v030/natural.json
!/tests/fixtures/physician-v0700/
/tests/fixtures/physician-v0700/*
!/tests/fixtures/physician-v0700/natural.json
!/tests/fixtures/harvestpriest-v0710/
/tests/fixtures/harvestpriest-v0710/*
!/tests/fixtures/harvestpriest-v0710/natural.json
